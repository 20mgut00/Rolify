# =========================================
# RPG CHARACTER CREATOR - Environment Variables
# =========================================
# Copia este archivo como .env y rellena con tus valores reales

# ===== Google OAuth (Opcional) =====
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===== Email Configuration (Resend) =====
RESEND_API_KEY=re_your_api_key_here
MAIL_PASSWORD=re_your_api_key_here
EMAIL_FROM=onboarding@resend.dev
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend

# ===== JWT Security =====
JWT_SECRET=your-256-bit-secret-key-change-this-in-production

# ===== MongoDB Configuration =====
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_DATABASE=rpg-characters

# ===== Frontend URL (para CORS y enlaces en emails) =====
FRONTEND_URL=http://localhost:3000

# ===== Gemini API Key (para generación de personajes con IA) =====
GEMINI_API_KEY=your-gemini-api-key
